# ─────────────────────────────────────────────────────────────────────────────
# PlaySlot environment. Copy to `.env` and fill in. Validated at boot by
# packages/config (zod) — the API/web will refuse to start if required vars are
# missing. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000          # Next.js web
API_BASE_URL=http://localhost:3001          # NestJS api

# seo — public origin used for canonical URLs, hreflang, sitemap and robots.
# MUST be the real origin per environment (https://playslot.bg in production,
# https://staging.playslot.bg on staging) or Google will index canonical tags
# pointing at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Indexing is OFF unless this is exactly "true". Production sets it; staging and
# previews must not, so they never compete with playslot.bg in search results.
NEXT_PUBLIC_ALLOW_INDEXING=false

# data (matches docker-compose.yml)
DATABASE_URL=postgresql://playslot:dev@localhost:5432/playslot?schema=public
REDIS_URL=redis://localhost:6379

# auth
AUTH_SECRET=change-me-to-a-long-random-string
# Google OAuth — set the Authorized redirect URI in Google Cloud Console to:
#   ${API_BASE_URL}/api/auth/google/callback   (e.g. http://localhost:3001/api/auth/google/callback)
# Start sign-in at: ${API_BASE_URL}/api/auth/google?returnTo=/bg
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# bot protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# web push (browser notifications). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Unset => the API logs notifications instead of sending them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@playslot.bg

# payments (Stripe) — required from Phase 7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# email / storage / maps / observability
# Transport: leave MAIL_PROVIDER blank to auto-select by key (SendGrid, then
# Resend, else console). MAIL_FROM defaults to "PlaySlot <no-reply@playslot.bg>".
MAIL_PROVIDER=
MAIL_FROM=

# Every new booking is copied to this inbox (ops visibility). Leave empty to turn it off.
PLATFORM_NOTIFY_EMAIL=info@playslot.bg
# The site proxies /api to the API (apps/web next.config.ts). In production:
#   OAUTH_REDIRECT_BASE_URL=https://playslot.bg   (+ register the callback in Google Cloud)
#   TRUST_PROXY_HOPS=2                            (Vercel + Railway in front of the API)
OAUTH_REDIRECT_BASE_URL=
TRUST_PROXY_HOPS=1
RESEND_API_KEY=
SENDGRID_API_KEY=
# SendGrid dynamic templates. Upload them with:
#   pnpm --filter @playslot/api mail:sync
# which prints these ids. Leave empty to send the plain inline HTML instead.
SENDGRID_TEMPLATE_WELCOME=
SENDGRID_TEMPLATE_VERIFY_EMAIL=
SENDGRID_TEMPLATE_BOOKING_RECEIVED=
SENDGRID_TEMPLATE_BOOKING_CONFIRMED=
SENDGRID_TEMPLATE_BOOKING_CANCELLED=
SENDGRID_TEMPLATE_NOTICE=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# policy defaults (overridable per club in the DB — spec §12)
HOLD_TTL_MIN=10
MAX_ADVANCE_DAYS=14
DEFAULT_CURRENCY=EUR

# web-only public vars (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
