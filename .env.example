# ─────────────────────────────────────────────────────────────────────────────
# PlaySlot environment. Copy to `.env` and fill in. Validated at boot by
# packages/config (zod) — the API/web will refuse to start if required vars are
# missing. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000          # Next.js web
API_BASE_URL=http://localhost:3001          # NestJS api

# data (matches docker-compose.yml)
DATABASE_URL=postgresql://playslot:dev@localhost:5432/playslot?schema=public
REDIS_URL=redis://localhost:6379

# auth
AUTH_SECRET=change-me-to-a-long-random-string
# Google OAuth — set the Authorized redirect URI in Google Cloud Console to:
#   ${API_BASE_URL}/api/auth/google/callback   (e.g. http://localhost:3001/api/auth/google/callback)
# Start sign-in at: ${API_BASE_URL}/api/auth/google?returnTo=/bg
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# bot protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# payments (Stripe) — required from Phase 7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# email / storage / maps / observability
RESEND_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# policy defaults (overridable per club in the DB — spec §12)
HOLD_TTL_MIN=10
MAX_ADVANCE_DAYS=14
DEFAULT_CURRENCY=EUR

# web-only public vars (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
