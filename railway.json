{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "packages/db/node_modules/.bin/prisma migrate deploy --schema packages/db/prisma/schema.prisma"
    ]
  }
}
